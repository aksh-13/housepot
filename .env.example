# Copy to .env.local for local development. Everything works with these defaults and no outside accounts.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/housepot
BASE_URL=http://localhost:3000
TICK_SECRET=dev-tick-secret

# fake = texts are saved and shown at /dev/outbox. twilio = real texts.
SMS_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# fake = a pretend checkout page at /dev/fake-checkout. stripe = real card payments.
PAYMENTS_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# disk = photos saved under .data/photos. db = photos kept in the database (no other setup; good for
# a small deployment on a host with no disk). s3 = any S3-compatible store (MinIO, R2, S3).
STORAGE_PROVIDER=disk
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=housepot
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Comma-separated phone numbers and emails allowed to open /operator (pending e-Transfers).
OPERATOR_PHONES=
OPERATOR_EMAILS=

# How people sign in, and how every reminder reaches them. phone = a texted code (SMS_PROVIDER above).
# email = an emailed code (EMAIL_PROVIDER below).
SIGN_IN=phone

# Only used when SIGN_IN=email. fake = emails are saved and shown at /dev/outbox.
# smtp = any SMTP server. With Gmail: smtp.gmail.com, port 465, your address, and an app password
#   (Google account -> Security -> 2-Step Verification -> App passwords). Some hosts block SMTP:
#   Railway's Hobby plan does.
# resend = Resend's HTTPS API. Needs a domain you have verified with Resend.
EMAIL_PROVIDER=fake
# "Housepot <you@gmail.com>" or "Housepot <hello@your-domain.com>"
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# Settling up by e-Transfer. fake = /dev/inbox and a pretend Interac page stand in for real emails.
# webhook = real Interac emails, forwarded to pay-<token>@INBOUND_EMAIL_DOMAIN and posted to
# /api/webhooks/email by whatever receives mail for that domain, with this secret.
# off = no checking at all; housemates use "I sent it" and "It arrived".
INBOUND_EMAIL_PROVIDER=fake
INBOUND_EMAIL_DOMAIN=pay.housepot.local
INBOUND_EMAIL_SECRET=dev-inbound-secret

# on = people can start a card-deposit house. off = e-Transfer houses only, and the pretend checkout
# and the payments webhook are closed. Set off in production until Stripe is set up.
CARD_HOUSES=on
