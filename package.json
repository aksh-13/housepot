{
  "name": "housepot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "db:up": "sh scripts/dev-db.sh",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "k8s:up": "sh scripts/kind-up.sh",
    "k8s:down": "sh scripts/kind-down.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "luxon": "^3.7.2",
    "next": "^15.5.29",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.1.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.20.0"
}
