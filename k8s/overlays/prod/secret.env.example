# Copy to secret.env (gitignored) and fill in. Kustomize turns this file into the housepot-secrets Secret.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/housepot?sslmode=require
TICK_SECRET=replace-with-a-long-random-string
OPERATOR_PHONES=+19055550100
S3_ENDPOINT=https://replace-me.example.com
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
